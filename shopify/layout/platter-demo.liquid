<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction | default: 'ltr' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title | escape }}</title>
    <meta
      name="description"
      content="{{ page_description | default: 'A responsive Shopify featured collection for the Platter technical challenge.' | escape }}"
    >
    <link rel="canonical" href="{{ canonical_url | escape }}">
    <style>
      body {
        margin: 0;
        background: #fff;
      }

      .platter-demo-title {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
      }
    </style>
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">
      <h1 class="platter-demo-title">{{ page.title | default: 'Platter Challenge Demo' | escape }}</h1>
      {{ content_for_layout }}
    </main>
  </body>
</html>
